# Next.js runtime
APP_BASE_URL=http://localhost:3000

# Existing PostgreSQL persistence used by /api/auth and /api/data
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Existing Google OAuth flow (optional if using the current custom auth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Existing password-reset/email verification delivery (optional)
RESEND_API_KEY=
RESEND_FROM=AV Attendance Tracker <noreply@example.com>

# Firebase migration target
# These are safe browser-side Firebase config values, but must be replaced with
# the values from Firebase Console > Project settings > Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server-only; never prefix these with NEXT_PUBLIC_)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
